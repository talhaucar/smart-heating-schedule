{
  "entity": {
    "select": {
      "presence_mode": {
        "default": "mdi:home-account",
        "state": {
          "auto": "mdi:map-marker-radius",
          "home": "mdi:home",
          "away": "mdi:walk"
        }
      }
    },
    "sensor": {
      "active_profile": {
        "default": "mdi:home",
        "state": {
          "away": "mdi:walk"
        }
      },
      "scheduled_temperature": {
        "default": "mdi:thermometer-auto"
      }
    },
    "switch": {
      "smart_schedule": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-remove"
        }
      }
    }
  },
  "services": {
    "resume_schedule": {
      "service": "mdi:calendar-sync"
    },
    "get_schedule": {
      "service": "mdi:calendar-search"
    },
    "set_schedule": {
      "service": "mdi:calendar-edit"
    }
  }
}
